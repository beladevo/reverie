#!/usr/bin/env python3
import os
import sys
from pathlib import Path

if os.name == "nt":
    if sys.argv[1:2] == ["hook"]:
        sys.exit(0)
    sys.exit("reverie: Windows is not supported yet")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from reverie.cli import main  # noqa: E402

main()
